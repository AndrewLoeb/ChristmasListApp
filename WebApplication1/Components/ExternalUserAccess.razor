@using WebApplication1.Models
@using WebApplication1.Services
@using WebApplication1.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject googleSheetsListService ListService
@inject ExternalAccessService ExternalAccessService
@inject allListsService allListsService
@inject IJSRuntime JSRuntime

@using Blazored.Toast
@using Blazored.Toast.Services
@inject IToastService toastService

<BlazoredToasts Timeout="10"
                ShowProgressBar="true"
                IconType="IconType.FontAwesome"
                ErrorClass="error-toast-override"
                ErrorIcon="fa fa-exclamation-triangle" />

@if (!isValidToken)
{
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="alert alert-danger mt-5" role="alert">
                <h4 class="alert-heading">Invalid Access Link</h4>
                <p>The access link you used is not valid. Please check the URL and try again.</p>
            </div>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading gift lists...</p>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="page-nav-group" role="group" aria-label="Page navigation">
            <button type="button" class="page-nav-btn @(tabIndex == 1 ? "active" : "")" @onclick="Set_ListReview">List Review</button>
            <button type="button" class="page-nav-btn @(tabIndex == 2 ? "active" : "")" @onclick="Set_MyGifts">My Gifts</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted">@ExternalAccessService.ExternalUserName</span>
        </div>
    </div>

    <div>
        @if (tabIndex == 1)
        {
            <ExternalListReview></ExternalListReview>
        }
        @if (tabIndex == 2)
        {
            <ExternalMyGifts></ExternalMyGifts>
        }
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; }

    private bool isValidToken = false;
    private bool isLoading = true;
    private int tabIndex = 1;

    protected override async Task OnInitializedAsync()
    {
        // Validate token
        isValidToken = ExternalAccessService.SetExternalUser(Token);

        if (isValidToken)
        {
            try
            {
                // Load external user data (filtered by VisibleToExternal)
                await allListsService.LoadExternalUserData(ListService);
                isLoading = false;
            }
            catch (Exception ex)
            {
                toastService.ShowError($"Error loading data: {ex.Message}");
                isValidToken = false;
                isLoading = false;
            }
        }
        else
        {
            isLoading = false;
        }
    }

    public void Set_ListReview()
    {
        tabIndex = 1;
    }

    public void Set_MyGifts()
    {
        tabIndex = 2;
    }
}
